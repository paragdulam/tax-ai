{
  "name": "taxai-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/tailwind.css --watch",
    "dev": "npm run build:css && tauri dev",
    "build": "npm run build:css && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@tauri-apps/plugin-sql": "^2.4.0"
  }
}
